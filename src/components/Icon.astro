---
interface Props {
  name: 'arrow' | 'menu' | 'close' | 'train' | 'bus' | 'car' | 'walk' | 'clock' | 'fish' | 'rice' | 'cup' | 'bag' | 'map' | 'check' | 'info' | 'ship' | 'camera' | 'parking' | 'child';
  size?: number;
  class?: string;
}

const { name, size = 20, class: className = '' } = Astro.props;
const common = {
  width: size,
  height: size,
  viewBox: '0 0 24 24',
  fill: 'none',
  stroke: 'currentColor',
  'stroke-width': 1.8,
  'stroke-linecap': 'round',
  'stroke-linejoin': 'round',
  'aria-hidden': 'true',
};
---

{name === 'arrow' && <svg {...common} class={className}><path d="M5 12h14"/><path d="m13 6 6 6-6 6"/></svg>}
{name === 'menu' && <svg {...common} class={className}><path d="M4 7h16M4 12h16M4 17h16"/></svg>}
{name === 'close' && <svg {...common} class={className}><path d="m6 6 12 12M18 6 6 18"/></svg>}
{name === 'train' && <svg {...common} class={className}><rect x="6" y="3" width="12" height="15" rx="3"/><path d="M8 21l2-3m6 3-2-3M9 7h6M9 13h.01M15 13h.01"/></svg>}
{name === 'bus' && <svg {...common} class={className}><rect x="5" y="3" width="14" height="17" rx="3"/><path d="M7 16h10M8 7h8M8 20v1m8-1v1M8.5 12h.01m7 0h.01"/></svg>}
{name === 'car' && <svg {...common} class={className}><path d="m5 11 2-5h10l2 5"/><rect x="3" y="10" width="18" height="8" rx="2"/><path d="M6 18v2m12-2v2M7 14h.01M17 14h.01"/></svg>}
{name === 'walk' && <svg {...common} class={className}><circle cx="13" cy="4" r="2"/><path d="m10 22 1-7-3-2 2-5 4 2 2 4h3m-8 1 4 3 1 4"/></svg>}
{name === 'clock' && <svg {...common} class={className}><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>}
{name === 'fish' && <svg {...common} class={className}><path d="M4 12c4-5 9-6 14-2l3-3v10l-3-3c-5 4-10 3-14-2Z"/><path d="M8 12h.01"/></svg>}
{name === 'rice' && <svg {...common} class={className}><path d="M12 21V7m0 5-4-3m4 7-5-3m5-4 4-3m-4 7 5-3"/><path d="M7 21h10"/></svg>}
{name === 'cup' && <svg {...common} class={className}><path d="M5 8h12v7a5 5 0 0 1-5 5H10a5 5 0 0 1-5-5V8Z"/><path d="M17 10h1a3 3 0 0 1 0 6h-1M8 4h6"/></svg>}
{name === 'bag' && <svg {...common} class={className}><path d="M6 8h12l1 13H5L6 8Z"/><path d="M9 8a3 3 0 0 1 6 0"/></svg>}
{name === 'map' && <svg {...common} class={className}><path d="m3 6 6-3 6 3 6-3v15l-6 3-6-3-6 3V6Z"/><path d="M9 3v15m6-12v15"/></svg>}
{name === 'check' && <svg {...common} class={className}><path d="m5 12 4 4L19 6"/></svg>}
{name === 'info' && <svg {...common} class={className}><circle cx="12" cy="12" r="9"/><path d="M12 11v5M12 8h.01"/></svg>}
{name === 'ship' && <svg {...common} class={className}><path d="M4 17 2 14l3-1V7l7-4 7 4v6l3 1-2 3"/><path d="M5 20c2 1 3 1 5 0s3-1 5 0 3 1 5 0M8 8h8M12 4v9"/></svg>}
{name === 'camera' && <svg {...common} class={className}><path d="M4 7h3l2-3h6l2 3h3v13H4V7Z"/><circle cx="12" cy="13" r="4"/></svg>}
{name === 'parking' && <svg {...common} class={className}><rect x="4" y="3" width="16" height="18" rx="2"/><path d="M9 17V7h4a3 3 0 0 1 0 6H9"/></svg>}
{name === 'child' && <svg {...common} class={className}><circle cx="12" cy="5" r="2"/><path d="M8 22l1-7-3-3 2-4 4 2 4-2 2 4-3 3 1 7m-7-7h6"/></svg>}
