---
interface Props {
  eyebrow: string;
  title: string;
  description?: string;
  align?: 'left' | 'center';
}
const { eyebrow, title, description, align = 'left' } = Astro.props;
---

<div class:list={[align === 'center' ? 'mx-auto max-w-3xl text-center' : 'max-w-3xl']}>
  <p class:list={['eyebrow', align === 'center' && 'justify-center']}>{eyebrow}</p>
  <h2 class="section-title mt-4">{title}</h2>
  {description && <p class="body-copy mt-5 text-sm md:text-base">{description}</p>}
</div>
