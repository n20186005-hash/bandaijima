---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import SectionTitle from '../components/SectionTitle.astro';
import Icon from '../components/Icon.astro';
---

<BaseLayout
  title="買い物・お土産"
  description="ピアBandaiで選びたい鮮魚、新潟米、農産物、地酒、常温土産を、持ち歩き時間と旅程から案内する非公式ショッピングガイドです。"
  image="/images/seafood-market.webp"
>
  <PageHero
    eyebrow="TAKE NIIGATA HOME"
    title="新潟を、旅の鞄へ。"
    lead="旬の魚、米、地酒、農産物。おいしさだけでなく、保冷時間、重さ、渡す相手まで考えて選ぶ市場の買い物案内です。"
    image="/images/seafood-market.webp"
    imageAlt="新潟県内の魚市場に並ぶ海産物"
  />
  <Breadcrumbs items={[{ label: '買う' }]} />

  <section class="section-space">
    <div class="site-shell">
      <SectionTitle
        eyebrow="MARKET GUIDE"
        title="買う順番は、常温から。"
        description="最初に米菓や加工品などの常温品、次に米や酒、最後に鮮魚と冷蔵品。食事や周辺散歩を終えてから保冷品を受け取ると、旅程が組みやすくなります。"
      />

      <div class="mt-12 grid gap-7 lg:grid-cols-2">
        <article id="seafood" class="paper-panel scroll-mt-28 overflow-hidden">
          <div class="image-frame aspect-[16/9]"><img src="/images/seafood-market.webp" alt="氷の上に並ぶ海産物" width="1280" height="855" loading="lazy" /></div>
          <div class="p-7 md:p-9">
            <div class="flex items-center justify-between gap-4"><div><p class="text-[0.65rem] font-extrabold tracking-[0.16em] text-vermilion">01 · SEAFOOD</p><h2 class="mt-2 font-serif text-2xl font-semibold">鮮魚・海産物</h2></div><Icon name="fish" size={30} class="text-harbor" /></div>
            <p class="body-copy mt-5 text-sm">旬の魚、刺身、干物、加工品など。すぐ食べるのか、宿で食べるのか、自宅へ持ち帰るのかを先に伝えると選びやすくなります。</p>
            <ul class="mt-6 grid gap-3 text-xs leading-6 text-ink-soft">
              <li class="flex gap-2"><Icon name="check" size={17} class="mt-1 shrink-0 text-vermilion" />持ち歩き可能時間と保冷剤の目安を確認</li>
              <li class="flex gap-2"><Icon name="check" size={17} class="mt-1 shrink-0 text-vermilion" />宿泊先の冷蔵・冷凍設備を先に確認</li>
              <li class="flex gap-2"><Icon name="check" size={17} class="mt-1 shrink-0 text-vermilion" />宅配を使う場合は到着日と受け取り時間を確認</li>
            </ul>
          </div>
        </article>

        <article id="rice" class="paper-panel scroll-mt-28 overflow-hidden">
          <div class="image-frame aspect-[16/9]"><img src="/images/niigata-rice.webp" alt="新潟県十日町市の水田" width="1280" height="720" loading="lazy" /></div>
          <div class="p-7 md:p-9">
            <div class="flex items-center justify-between gap-4"><div><p class="text-[0.65rem] font-extrabold tracking-[0.16em] text-vermilion">02 · RICE & FARM</p><h2 class="mt-2 font-serif text-2xl font-semibold">新潟米・農産物</h2></div><Icon name="rice" size={30} class="text-harbor" /></div>
            <p class="body-copy mt-5 text-sm">品種、産地、精米日、容量を見比べる時間も市場の楽しみ。徒歩旅なら小容量、車旅や宅配なら食べ比べを選ぶと無理がありません。</p>
            <div class="mt-6 grid grid-cols-3 gap-2 text-center text-xs font-bold">
              <div class="border border-line bg-paper p-3">小容量<br/><span class="font-normal text-ink-soft">一人旅</span></div>
              <div class="border border-line bg-paper p-3">食べ比べ<br/><span class="font-normal text-ink-soft">贈り物</span></div>
              <div class="border border-line bg-paper p-3">宅配<br/><span class="font-normal text-ink-soft">まとめ買い</span></div>
            </div>
          </div>
        </article>

        <article id="sake" class="paper-panel scroll-mt-28 overflow-hidden lg:col-span-2 lg:grid lg:grid-cols-[.9fr_1.1fr]">
          <div class="image-frame min-h-[330px]"><img src="/images/niigata-sake.webp" alt="新潟の日本酒イベントに並ぶ酒樽" width="1280" height="960" loading="lazy" /></div>
          <div class="p-7 md:p-10">
            <div class="flex items-center justify-between gap-4"><div><p class="text-[0.65rem] font-extrabold tracking-[0.16em] text-vermilion">03 · SAKE & PANTRY</p><h2 class="mt-2 font-serif text-2xl font-semibold">地酒・常温の土産</h2></div><Icon name="bag" size={30} class="text-harbor" /></div>
            <p class="body-copy mt-5 text-sm">地酒は甘辛だけでなく、食中酒にしたいか、贈り物か、自宅用かを伝えると選びやすくなります。移動日には、米菓、乾物、調味料、菓子など常温品も実用的です。</p>
            <dl class="mt-7 grid gap-4 border-y border-line py-6 text-sm sm:grid-cols-3">
              <div><dt class="text-[0.62rem] font-extrabold tracking-[0.12em] text-vermilion">TRAIN / WALK</dt><dd class="mt-2 font-serif text-lg">軽さ優先</dd></div>
              <div><dt class="text-[0.62rem] font-extrabold tracking-[0.12em] text-vermilion">CAR</dt><dd class="mt-2 font-serif text-lg">容量で選ぶ</dd></div>
              <div><dt class="text-[0.62rem] font-extrabold tracking-[0.12em] text-vermilion">GIFT</dt><dd class="mt-2 font-serif text-lg">相手の食卓から</dd></div>
            </dl>
            <p class="notice-box mt-6 text-xs leading-6 text-ink-soft">酒類は割れ物です。飛行機、船、国際移動では持ち込み・預け入れ条件を利用交通機関で確認してください。</p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="bg-harbor text-white py-16 md:py-24">
    <div class="site-shell">
      <div class="grid gap-8 lg:grid-cols-[.8fr_1.2fr] lg:items-end">
        <div><p class="text-[0.68rem] font-extrabold tracking-[0.22em] text-white/[.55]">PACKING PLAN</p><h2 class="mt-4 font-serif text-3xl font-semibold md:text-4xl">旅の続き方で、選び方を変える。</h2></div>
        <p class="text-sm leading-8 text-white/[.70]">同じ商品でも、次の予定がホテル、長距離列車、飛行機、フェリーでは扱いが変わります。購入前に「あと何時間持ち歩くか」を店員へ伝えます。</p>
      </div>
      <div class="mt-10 grid gap-px bg-white/[.15] md:grid-cols-4">
        {[
          ['宿へ戻る', '冷蔵設備を確認し、到着後すぐ保管。'],
          ['街を歩く', '常温品を先に。冷蔵品は帰る直前。'],
          ['長距離移動', '保冷時間、乗換、荷物の重さを優先。'],
          ['宅配する', '到着日、送料、受取可能時間を確認。'],
        ].map(([title, text], index) => (
          <article class="bg-harbor p-6 md:p-7"><p class="font-serif text-3xl text-white/[.26]">0{index + 1}</p><h3 class="mt-5 font-serif text-xl font-semibold">{title}</h3><p class="mt-3 text-xs leading-6 text-white/[.66]">{text}</p></article>
        ))}
      </div>
    </div>
  </section>

  <section class="section-space">
    <div class="site-shell">
      <SectionTitle eyebrow="SEASONAL NOTE" title="旬は、売り場で出会うもの。" description="魚介や農産物の旬は年や天候で前後し、毎日同じ品が並ぶとは限りません。下の季節感は旅の目安として使い、当日のおすすめを売り場で聞いてください。" />
      <div class="mt-10 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        {[
          ['春', '山菜、春野菜、やわらかな魚介を探す季節。'],
          ['夏', '枝豆、夏野菜、さっぱり味わう海の幸。'],
          ['秋', '新米、きのこ、実りを持ち帰る季節。'],
          ['冬', '寒い港で、脂ののった魚と温かな料理。'],
        ].map(([season, text]) => (
          <article class="paper-panel p-6"><p class="stamp">{season}</p><p class="body-copy mt-6 text-sm">{text}</p></article>
        ))}
      </div>
      <div class="mt-10 flex flex-wrap gap-3"><a href="/hours/" class="button-primary">営業情報の見方 <Icon name="arrow" size={17} /></a><a href="/course/" class="button-quiet">買い物を含むコース <Icon name="arrow" size={17} /></a></div>
    </div>
  </section>
</BaseLayout>
