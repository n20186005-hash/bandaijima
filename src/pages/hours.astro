---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import SectionTitle from '../components/SectionTitle.astro';
import Icon from '../components/Icon.astro';
import { shops } from '../data/shops';
---

<BaseLayout
  title="営業時間・休業日｜ピアBandaiの店ごとの違い"
  description="ピアBandaiの営業時間を店舗別に確認するための非公式ガイド。施設全体の時間帯、飲食店ごとの差、売り切れや臨時変更への備えを案内します。"
  image="/images/pia-bandai-hero.webp"
>
  <PageHero
    eyebrow="OPENING HOURS"
    title="一つの市場、時間は店ごと。"
    lead="施設全体は朝から夜まで動きますが、鮮魚、飲食、カフェでは開店・閉店・休業日が異なります。旅程には余白を持たせます。"
    image="/images/pia-bandai-hero.webp"
    imageAlt="みなとのマルシェ ピアBandaiの建物と広場"
    compact
  />
  <Breadcrumbs items={[{ label: '営業時間' }]} />

  <section class="section-space">
    <div class="site-shell">
      <div class="grid gap-10 lg:grid-cols-[.72fr_1.28fr] lg:items-start">
        <div>
          <SectionTitle eyebrow="BEFORE YOU GO" title="「9時〜21時」は、全店共通ではありません。" description="施設案内ではおおむね9:00〜21:00の幅が示されますが、店舗ごとの営業時間、ラストオーダー、定休日、季節営業が優先されます。" />
          <div class="notice-box mt-7">
            <p class="flex gap-2 text-sm font-bold"><Icon name="info" size={18} class="mt-0.5 shrink-0 text-vermilion" />このページは旅行計画用の目安です。</p>
            <p class="mt-2 text-xs leading-6 text-ink-soft">当日の店頭表示、施設のお知らせ、スタッフ案内を最優先してください。</p>
          </div>
        </div>
        <div class="paper-panel overflow-hidden">
          <div class="awning-stripe h-2"></div>
          <div class="grid grid-cols-3 divide-x divide-line p-6 text-center md:p-9">
            <div><Icon name="clock" size={24} class="mx-auto text-vermilion" /><p class="mt-3 text-[0.64rem] font-extrabold tracking-[0.12em] text-ink-soft">MARKET RANGE</p><p class="mt-2 font-serif text-xl">朝〜夜</p></div>
            <div><Icon name="fish" size={24} class="mx-auto text-vermilion" /><p class="mt-3 text-[0.64rem] font-extrabold tracking-[0.12em] text-ink-soft">FRESH FOOD</p><p class="mt-2 font-serif text-xl">早めが安心</p></div>
            <div><Icon name="cup" size={24} class="mx-auto text-vermilion" /><p class="mt-3 text-[0.64rem] font-extrabold tracking-[0.12em] text-ink-soft">DINING</p><p class="mt-2 font-serif text-xl">店ごとに確認</p></div>
          </div>
        </div>
      </div>

      <div class="mt-14 overflow-hidden border border-line bg-white/[.62]">
        <div class="hidden grid-cols-[1.3fr_.9fr_.9fr] gap-5 bg-harbor px-6 py-4 text-[0.65rem] font-extrabold tracking-[0.13em] text-white md:grid">
          <span>店舗・ジャンル</span><span>営業時間の目安</span><span>休み・注意</span>
        </div>
        <div class="divide-y divide-line">
          {shops.map((shop, index) => (
            <article class="grid gap-4 px-5 py-6 md:grid-cols-[1.3fr_.9fr_.9fr] md:gap-5 md:px-6">
              <div class="grid grid-cols-[52px_1fr] gap-4">
                <div class="image-frame h-13 w-13"><img src={shop.image} alt="" width="104" height="104" loading="lazy" /></div>
                <div><p class="text-[0.62rem] font-extrabold tracking-[0.1em] text-vermilion">0{index + 1} · {shop.categoryLabel}</p><h2 class="mt-1 font-serif text-lg font-semibold">{shop.name}</h2></div>
              </div>
              <div><p class="mb-1 text-[0.62rem] font-extrabold tracking-[0.1em] text-ink-soft md:hidden">営業時間</p><p class="text-xs leading-6 text-ink-soft">{shop.hours}</p></div>
              <div><p class="mb-1 text-[0.62rem] font-extrabold tracking-[0.1em] text-ink-soft md:hidden">休み・注意</p><p class="text-xs leading-6 text-ink-soft">{shop.closed}{shop.note ? `。${shop.note}` : ''}</p></div>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="bg-paper-deep/[.70] py-16 md:py-24">
    <div class="site-shell">
      <SectionTitle eyebrow="CHECK ORDER" title="当日は、この順で確認。" align="center" />
      <div class="mt-12 grid gap-5 md:grid-cols-4">
        {[
          ['到着前', '臨時休業や季節営業がないか、最新案内を確認。'],
          ['到着時', '入口や店頭の営業時間、待ち時間、売り切れ表示を見る。'],
          ['注文前', 'ラストオーダーと提供時間を確認。次の交通時刻から逆算。'],
          ['買い物前', '保冷品は最後に。受取、宅配、持ち歩き時間を相談。'],
        ].map(([title, text], index) => (
          <article class="relative border-t-2 border-harbor bg-white/[.65] p-6"><span class="font-serif text-4xl text-gold/[.55]">0{index + 1}</span><h3 class="mt-4 font-serif text-xl font-semibold">{title}</h3><p class="body-copy mt-3 text-xs">{text}</p></article>
        ))}
      </div>
    </div>
  </section>

  <section class="section-space">
    <div class="site-shell grid gap-8 lg:grid-cols-[1fr_.82fr] lg:items-center">
      <div><p class="eyebrow">GOOD TIMING</p><h2 class="section-title mt-4">朝は買い物、昼は食事。<br />目的を一つ先に。</h2><p class="body-copy mt-6">鮮魚や農産物を重視するなら早め、飲食を重視するなら開店時間と昼の混雑を確認。夕方は売り切れや早仕舞いの可能性も考えます。</p><p class="body-copy mt-4 text-sm">到着時刻を決める前に、<a href="/access/" class="font-bold text-harbor underline decoration-line underline-offset-4">行き方と駐車場</a>を確認しておくと、開店・ラストオーダーから逆算しやすくなります。</p></div>
      <div class="grid gap-3 sm:grid-cols-3 lg:grid-cols-1">
        <div class="paper-panel flex gap-4 p-5"><span class="font-serif text-2xl text-vermilion">朝</span><p class="text-xs leading-6 text-ink-soft">売り場を見比べ、買い物中心に。</p></div>
        <div class="paper-panel flex gap-4 p-5"><span class="font-serif text-2xl text-vermilion">昼</span><p class="text-xs leading-6 text-ink-soft">第一候補と代案を決め、混雑対応。</p></div>
        <div class="paper-panel flex gap-4 p-5"><span class="font-serif text-2xl text-vermilion">夕</span><p class="text-xs leading-6 text-ink-soft">売り切れと閉店時刻に注意。</p></div>
      </div>
    </div>
  </section>
</BaseLayout>
